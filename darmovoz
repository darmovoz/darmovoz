async function submitReg(){var nm=gid('reg-name').value.trim(),ph=gid('reg-phone').value.trim();if(!nm||!ph){gid('reg-result').innerHTML='<span style="color:#dc3545">Заполните имя и телефон</span>';return;}if(!gid('agree').checked){gid('reg-result').innerHTML='<span style="color:#dc3545">Примите договор</span>';return;}try{var r=await fetch('/api/drivers/register',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:nm,phone:ph,courier_type:gid('reg-ct').value,car:gid('reg-car').value,contract_accepted:true})});var d=await r.json();if(r.ok){gid('reg-card').style.display='none';gid('login-card').style.display='block';gid('login-err').innerHTML='<div style="background:#e8f5e9;padding:12px;border-radius:8px">✅ Регистрация! ID: <b>'+d.id+'</b></div>';gid('drv-id').value=d.id;}else{gid('reg-result').innerHTML='<span style="color:#dc3545">'+(d.detail||'Ошибка')+'</span>';}}catch(e){gid('reg-result').innerHTML='<span style="color:#dc3545">Сеть недоступна</span>';}}
