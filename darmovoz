@app.get("/api/drivers/{did}/orders")
async def drv_orders(did:int,db:Session=Depends(get_db)):
    os_=db.query(Order).filter(Order.driver_id==did,Order.status.in_(["assigned","picked"])).all()
    pts_map={}
    for o in os_:
        pts=db.query(OrderPoint).filter(OrderPoint.order_id==o.id).order_by(OrderPoint.seq).all()
        all_done=all(p.completed or p.cancelled for p in pts if p.point_type=="delivery")
        next_pt=None;next_dist=None;can_next=True
        last_delivery=None;last_dist=None;can_deliver=True
        for p in pts:
            if not p.completed and not p.cancelled:
                if not next_pt:
                    next_pt=p
                    if d:=db.query(Driver).filter(Driver.id==did).first():
                        if p.lat and d.lat:
                            next_dist=round(haversine(p.lat,p.lon,d.lat,d.lon)*1000)
                            can_next=next_dist<=500
        cat_labels={"burning":"🔥 Горящий","urgent":"⚡ Срочный","current":"📍 Текущий","preliminary":"📋 Предварительный"}
        result_pts=[{"seq":p.seq,"address":p.address,"point_type":p.point_type,
                      "contact_name":p.contact_name,"contact_phone":p.contact_phone,
                      "completed":p.completed,"cancelled":p.cancelled,
                      "completed_dist_m":p.completed_dist_m,
                      "photos":json.loads(p.photos) if p.photos else []} for p in pts]
        yield_data={"id":o.id,"status":o.status,"price":o.price,
                     "category_label":cat_labels.get(o.category,o.category),
                     "from_addr":o.from_addr,"to_addr":o.to_addr,
                     "client_name":o.client_name,"client_phone":o.client_phone,
                     "comment":o.comment,"points":result_pts,
                     "payment_status":o.payment_status,"loaders":o.loaders,
                     "pricing_type":o.pricing_type,"ordered_hours":o.ordered_hours,
                     "start_at":o.start_at.isoformat() if o.start_at else None,
                     "points_count":o.points_count,
                     "all_points_done":all_done,
                     "next_point":{"seq":next_pt.seq,"address":next_pt.address} if next_pt else None,
                     "next_dist_m":next_dist,"can_complete_next":can_next,
                     "can_deliver":can_deliver,"geofence_radius":500}
        pts_map[o.id]=yield_data
    return list(pts_map.values())

