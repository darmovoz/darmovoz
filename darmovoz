<label style="margin-top:10px">Комментарий</label><textarea name="comment" rows="2"></textarea>
<div class="row" style="margin-top:12px"><div><label>Груз</label><select name="cargo_type"><option value="standard">Обычный</option><option value="fragile">Хрупкий</option></select></div>
<div><label>Грузчики</label><select name="loaders"><option value="0">Нет</option><option value="1">1</option><option value="2">2</option></select></div></div>
<div class="row"><div><label>Этаж вверх</label><input type="number" name="floors_up" value="0" min="0"></div><div><label>Этаж вниз</label><input type="number" name="floors_down" value="0" min="0"></div><div><label>Лифт</label><select name="has_elevator"><option value="false">Нет</option><option value="true">Есть</option></select></div></div>
<button type="submit" id="submit-btn">Заказать и узнать цену</button></form>
<div class="result" id="result"></div></div></div>
<div class="page" id="page-myorders"><div class="card"><h2>📂 Мои заказы</h2><div class="orders-list" id="my-orders"></div></div></div>
<div class="page" id="page-track"><div class="card"><h2>Отслеживание</h2>
<input id="track-id" placeholder="Номер заказа" style="margin-bottom:8px">
<button id="track-btn" type="button" style="background:linear-gradient(135deg,#666,#444)">Отследить</button>
<div id="track-info"></div><div id="track-map"></div></div></div>
<div class="page" id="page-pay"><div class="card"><h2>💳 Оплата</h2><div id="pay-orders-list"></div></div></div>
<div class="modal" id="pay-modal"><div class="modal-box">
<h2 style="font-size:18px;margin-bottom:12px">💳 Оплата картой</h2>
<p style="font-size:14px;margin-bottom:8px">Заказ <span id="pay-order-id"></span> — <b id="pay-amount"></b></p>
<label>Номер карты</label><input id="card-number" placeholder="0000 0000 0000 0000" maxlength="19">
<div style="display:flex;gap:8px"><div style="flex:1"><label>Срок</label><input id="card-expiry" placeholder="12/25" maxlength="5"></div><div style="flex:1"><label>CVC</label><input id="card-cvc" placeholder="123" maxlength="3" type="password"></div></div>
<button class="btn-pay" id="pay-confirm-btn">Оплатить</button>
<button style="background:#6c757d;margin-top:6px" onclick="closePayModal()">Отмена</button>
<div id="pay-result" style="margin-top:8px;font-size:14px;text-align:center"></div></div></div>
<div class="modal" id="invoice-modal"><div class="modal-box">
<h2 style="font-size:18px;margin-bottom:12px">🧾 Оплата по счёту</h2>
<p style="font-size:14px;margin-bottom:8px">Заказ <span id="inv-order-id"></span> — <b id="inv-amount"></b></p>
<label>Email для счёта</label><input id="inv-email" placeholder="ivan@company.ru">
<div id="inv-company-info" style="font-size:13px;color:#666;margin:6px 0;display:none"></div>
<button class="btn-invoice" id="inv-confirm-btn">Запросить счёт</button>
<button style="background:#6c757d;margin-top:6px" onclick="closeInvoiceModal()">Отмена</button>
<div id="inv-result" style="margin-top:8px;font-size:14px;text-align:center"></div></div></div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
var ptSeq=0,pricingMode='distance',isOrderLegal=false,isRegLegal=false,payOrderId=null;
function showPage(n,e){document.querySelectorAll('.nav-btn').forEach(function(t){t.classList.remove('active')});document.querySelectorAll('.page').forEach(function(t){t.classList.remove('active')});e.target.classList.add('active');document.getElementById('page-'+n).classList.add('active');if(n==='myorders')loadOrders();if(n==='pay')loadPayOrders();}
function switchAuth(t,e){document.querySelectorAll('.auth-tab').forEach(function(x){x.classList.remove('active')});document.querySelectorAll('.auth-form').forEach(function(x){x.classList.remove('show')});e.target.classList.add('active');document.getElementById('auth-'+t).classList.add('show');}
function setRegLegal(v,e){isRegLegal=v;document.querySelectorAll('#auth-register .legal-toggle .lt').forEach(function(t){t.classList.remove('active')});e.target.classList.add('active');document.getElementById('reg-legal-fields').classList.toggle('show',v);}
function setOrderLegal(v,e){isOrderLegal=v;document.querySelectorAll('#page-order .legal-toggle .lt').forEach(function(t){t.classList.remove('active')});e.target.classList.add('active');document.getElementById('order-legal-fields').classList.toggle('show',v);}
function switchPricing(m,e){pricingMode=m;document.querySelectorAll('.ptab').forEach(function(t){t.classList.remove('active')});e.target.classList.add('active');document.getElementById('pricing-time').style.display=m==='time'?'block':'none';}
function initAC(inp){var tm=null,li=inp.parentElement.querySelector('.ac-list');inp.addEventListener('input',function(){clearTimeout(tm);var q=inp.value.trim();if(q.length<3){li.style.display='none';return;}tm=setTimeout(async function(){var r=await fetch('/api/geocode/search?q='+encodeURIComponent(q));var res=await r.json();if(!res.length){li.style.display='none';return;}li.innerHTML=res.map(function(it){return '<div class="ac-item" data-lat="'+it.lat+'" data-lon="'+it.lon+'" data-addr="'+it.display_name.replace(/"/g,'&quot;')+'">'+it.display_name+'</div>';}).join('');li.style.display='block';li.querySelectorAll('.ac-item').forEach(function(el){el.onclick=function(){inp.value=this.dataset.addr;var row=inp.closest('.pt-row');row.querySelector('.pt-lat').value=this.dataset.lat;row.querySelector('.pt-lon').value=this.dataset.lon;li.style.display='none';};});},400);});inp.addEventListener('blur',function(){setTimeout(function(){li.style.display='none';},200);});}
function addPoint(t){var c=document.getElementById('points-container');if(c.children.length>=30){alert('Максимум 30 точек');return;}ptSeq++;var d=document.createElement('div');d.className='pt-row '+(t||'pickup');d.innerHTML='<div class="pt-header"><span class="pt-num">Точка '+ptSeq+'</span><select class="pt-type-sel" onchange="ptTypeChange(this)"><option value="pickup">Погрузка</option><option value="delivery">Выгрузка</option></select> <button type="button" class="btn-sm" onclick="removePoint(this)">X</button></div><div class="ac-wrap"><input class="pt-addr" placeholder="Адрес..." required style="margin-bottom:4px"><div class="ac-list"></div></div><input class="pt-lat" type="hidden"><input class="pt-lon" type="hidden"><input class="pt-name" placeholder="Контакт" style="margin-top:4px"><input class="pt-phone" placeholder="Телефон" style="margin-top:4px">';c.appendChild(d);if(t==='delivery'){d.querySelector('.pt-type-sel').value='delivery';}initAC(d.querySelector('.pt-addr'));}
function ptTypeChange(s){s.parentElement.parentElement.className='pt-row '+s.value;}
function removePoint(b){var c=document.getElementById('points-container');if(c.children.length<=2){alert('Минимум 2 точки');return;}b.closest('.pt-row').remove();}
document.getElementById('btn-add-point').onclick=function(){addPoint();};addPoint('pickup');addPoint('delivery');
var now=new Date();now.setMinutes(now.getMinutes()-now.getTimezoneOffset());document.getElementById('start-at-input').value=now.toISOString().slice(0,16);
async function doLogin(){var ph=document.getElementById('login-phone').value.trim();if(!ph)return;try{var r=await fetch('/api/clients/login/'+encodeURIComponent(ph));if(!r.ok){document.getElementById('login-err').innerHTML='<span style="color:#dc3545">Не найден. Зарегистрируйтесь.</span>';return;}var d=await r.json();document.getElementById('auth-section').style.display='none';document.getElementById('profile-banner').innerHTML='Привет, <b>'+(d.name||'Клиент')+'</b> | Заказов: '+d.total_orders+' | Потрачено: '+d.total_spent+'₽';document.getElementById('profile-banner').style.display='block';document.getElementById('f-name').value=d.name||'';document.getElementById('f-phone').value=d.phone||'';document.getElementById('f-email').value=d.email||'';if(d.is_legal){setOrderLegal(true,{target:document.querySelectorAll('#page-order .legal-toggle .lt')[1]});document.getElementById('f-company').value=d.company_name||'';document.getElementById('f-inn').value=d.inn||'';document.getElementById('f-kpp').value=d.kpp||'';document.getElementById('f-ogrn').value=d.ogrn||'';document.getElementById('f-legal-addr').value=d.legal_address||'';}}catch(e){document.getElementById('login-err').innerHTML='<span style="color:#dc3545">Сеть недоступна</span>';}}
async function doRegister(){var nm=document.getElementById('reg-name').value.trim(),ph=document.getElementById('reg-phone').value.trim();if(!nm||!ph){document.getElementById('reg-err').innerHTML='<span style="color:#dc3545">Имя и телефон обязательны</span>';return;}var body={name:nm,phone:ph,email:document.getElementById('reg-email').value.trim(),is_legal:isRegLegal};if(isRegLegal){body.company_name=document.getElementById('reg-company').value.trim();body.inn=document.getElementById('reg-inn').value.trim();body.kpp=document.getElementById('reg-kpp').value.trim();body.ogrn=document.getElementById('reg-ogrn').value.trim();body.legal_address=document.getElementById('reg-legal-addr').value.trim();}try{var r=await fetch('/api/clients/register',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});var d=await r.json();if(r.ok){document.getElementById('reg-err').innerHTML='<span style="color:#28a745">'+d.message+'! Войдите по телефону.</span>';document.getElementById('login-phone').value=ph;switchAuth('login',{target:document.querySelectorAll('.auth-tab')[0]});}else{document.getElementById('reg-err').innerHTML='<span style="color:#dc3545">'+(d.detail||'Ошибка')+'</span>';}}catch(e){document.getElementById('reg-err').innerHTML='<span style="color:#dc3545">Сеть недоступна</span>';}}
document.getElementById('order-form').addEventListener('submit',async function(e){e.preventDefault();var btn=document.getElementById('submit-btn');btn.disabled=true;btn.textContent='Считаем...';var pts=[];document.querySelectorAll('.pt-row').forEach(function(r){pts.push({address:r.querySelector('.pt-addr').value,point_type:r.querySelector('.pt-type-sel').value,contact_name:r.querySelector('.pt-name').value,contact_phone:r.querySelector('.pt-phone').value,lat:r.querySelector('.pt-lat').value||null,lon:r.querySelector('.pt-lon').value||null});});if(pts.length<2){alert('Минимум 2 точки');btn.disabled=false;btn.textContent='Заказать и узнать цену';return;}var fd=new FormData();fd.append('client_name',document.querySelector('[name=client_name]').value);fd.append('client_phone',document.querySelector('[name=client_phone]').value);fd.append('client_email',document.querySelector('[name=client_email]').value);fd.append('courier_type',document.querySelector('[name=courier_type]').value);fd.append('pricing_type',pricingMode);fd.append('ordered_hours',pricingMode==='time'?document.getElementById('ordered-hours').value:0);fd.append('comment',document.querySelector('[name=comment]').value);fd.append('points_json',JSON.stringify(pts));fd.append('cargo_type',document.querySelector('[name=cargo_type]').value);fd.append('loaders',document.querySelector('[name=loaders]').value);fd.append('floors_up',document.querySelector('[name=floors_up]').value);fd.append('floors_down',document.querySelector('[name=floors_down]').value);fd.append('has_elevator',document.querySelector('[name=has_elevator]').value==='true');fd.append('start_at',document.getElementById('start-at-input').value);fd.append('is_legal',isOrderLegal);if(isOrderLegal){fd.append('client_company',document.getElementById('f-company').value);fd.append('client_inn',document.getElementById('f-inn').value);fd.append('client_kpp',document.getElementById('f-kpp').value);fd.append('client_ogrn',document.getElementById('f-ogrn').value);fd.append('client_legal_addr',document.getElementById('f-legal-addr').value);}try{var r=await fetch('/api/orders',{method:'POST',body:fd});var d=await r.json();var res=document.getElementById('result');if(r.ok){res.className='result ok';res.innerHTML='<div class="price">'+d.price+' ₽</div>Заказ #'+d.id+': '+d.message+'<br>Точек: '+d.points_count+' | Дистанция: '+d.distance_km+'км';document.getElementById('track-id').value=d.id;}else{res.className='result err';res.textContent=d.detail||'Ошибка';}res.style.display='block';}catch(err){document.getElementById('result').className='result err';document.getElementById('result').textContent='Сеть недоступна';document.getElementById('result').style.display='block';}btn.disabled=false;btn.textContent='Заказать и узнать цену';});
var tMap=null;
document.getElementById('track-btn').onclick=async function(){var id=document.getElementById('track-id').value.trim();if(!id)return;try{var r=await fetch('/api/orders/'+id);var d=await r.json();if(!r.ok){document.getElementById('track-info').innerHTML='<span style="color:red">Заказ не найден</span>';return;}var pr=await fetch('/api/orders/'+id+'/points');var pts=await pr.json();var st={created:'Создан',assigned:'Исполнитель назначен',picked:'В пути',delivered:'Доставлен',cancelled:'Отменён'};var h='<div style="font-size:13px;margin:8px 0"><b>'+(st[d.status]||d.status)+'</b>';if(d.start_at)h+='<br>⏰ '+new Date(d.start_at).toLocaleString('ru');h+='<br>Исполнитель: '+(d.driver_name||'—')+'<br>Цена: '+d.price+' ₽';if(d.payment_status==='paid')h+=' ✅';else if(d.payment_status==='invoice_requested')h+=' 🧾';else h+=' ❌';if(d.comment)h+='<br><i>'+d.comment+'</i>';h+='</div>';pts.forEach(function(p){h+=(p.point_type==='pickup'?'📦':'📋')+' <b>'+p.seq+'</b>. '+p.address+(p.completed?' ✅':'')+(p.cancelled?' ❌':'')+'<br>';});document.getElementById('track-info').innerHTML=h;if(pts.length&&pts[0].lat){if(tMap)tMap.remove();tMap=L.map('track-map').setView([pts[0].lat,pts[0].lon],11);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19}).addTo(tMap);var ll=[];pts.forEach(function(p){if(p.lat&&p.lon){ll.push([p.lat,p.lon]);L.marker([p.lat,p.lon]).addTo(tMap).bindPopup((p.point_type==='pickup'?'📦':'📋')+' '+p.seq+'. '+p.address);}});if(d.driver_lat&&d.driver_lon){L.marker([d.driver_lat,d.driver_lon]).addTo(tMap).bindPopup('Исполнитель');ll.push([d.driver_lat,d.driver_lon]);}if(ll.length>1)L.polyline(ll,{color:'#357abd',weight:3,dashArray:'5,8'}).addTo(tMap);if(ll.length>1)tMap.fitBounds(ll,{padding:[40,40]});}}catch(err){document.getElementById('track-info').textContent='Ошибка';}};
async function loadOrders(){try{var r=await fetch('/api/orders');var d=await r.json();document.getElementById('my-orders').innerHTML=d.slice(0,20).map(function(o){var ic={created:'⏳',assigned:'🚚',picked:'🛣️',delivered:'✅',cancelled:'❌'}[o.status]||'📋';var pay=o.payment_status==='paid'?'✅':o.payment_status==='invoice_requested'?'🧾':'❌';var payBtn=o.payment_status!=='paid'&&o.status!=='cancelled'?'<button class="btn-pay" style="width:auto;padding:6px 12px;font-size:12px;margin-top:4px" onclick="goPay('+o.id+')">💳 Оплатить</button>':'';return '<div class="order-item">'+ic+' <b>#'+o.id+'</b> — '+(o.points_count||2)+' точек<br>'+o.from_addr+' → '+o.to_addr+'<br>'+o.price+'₽ <span class="badge '+o.status+'">'+o.status+'</span> '+pay+'<br>'+payBtn+'</div>';}).join('')||'<div style="color:#999">Заказов нет</div>';}catch(e){}}
function goPay(oid){document.getElementById('track-id').value=oid;showPage('pay');setTimeout(function(){openPayModal(oid);},300);}
async function loadPayOrders(){try{var r=await fetch('/api/orders');var d=await r.json();var up=d.filter(function(o){return o.payment_status!=='paid'&&o.status!=='cancelled';});document.getElementById('pay-orders-list').innerHTML=up.map(function(o){return '<div class="order-item"><b>#'+o.id+'</b><br>'+o.from_addr+' → '+o.to_addr+'<br>'+o.price+'₽ <button class="btn-pay" style="width:auto;padding:8px 16px;font-size:13px" onclick="openPayModal('+o.id+')">💳 Картой</button> <button class="btn-invoice" style="width:auto;padding:8px 16px;font-size:13px" onclick="openInvoiceModal('+o.id+')">🧾 Счёт</button> <button class="btn-cash" style="width:auto;padding:8px 16px;font-size:13px" onclick="payCash('+o.id+')">💵 Наличные</button></div>';}).join('')||'<div style="color:#999;text-align:center;padding:20px">Все заказы оплачены ✅</div>';}catch(e){}}
function openPayModal(oid){fetch('/api/orders/'+oid).then(function(r){return r.json();}).then(function(d){payOrderId=oid;document.getElementById('pay-order-id').textContent='#'+oid;document.getElementById('pay-amount').textContent=d.price+' ₽';document.getElementById('pay-result').textContent='';document.getElementById('card-number').value='';document.getElementById('card-expiry').value='';document.getElementById('card-cvc').value='';document.getElementById('pay-modal').classList.add('show');});}
