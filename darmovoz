async function sendManual(){var lat=parseFloat(gid('m-lat').value),lon=parseFloat(gid('m-lon').value);if(isNaN(lat)||isNaN(lon))return;var fd=new FormData();fd.append('lat',lat);fd.append('lon',lon);await fetch('/api/drivers/'+driverId+'/location',{method:'POST',body:fd});gid('geo-status').textContent='Отправлено';loadAvail();}
async function loadAvail(){if(!driverId)return;try{var r=await fetch('/api/drivers/'+driverId+'/available-orders');var d=await r.json();if(!availMap&&document.getElementById('avail-map').offsetParent){availMap=L.map('avail-map').setView([59.9343,30.3351],11);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19}).addTo(availMap);}if(availMap){availMap.eachLayer(function(l){if(l instanceof L.Marker)availMap.removeLayer(l);});d.forEach(function(o){if(o.from_lat)L.marker([o.from_lat,o.from_lon],{icon:L.divIcon({html:o.category==='burning'?'🔥':'⚡',iconSize:[28,28],className:''})}).addTo(availMap).bindPopup('#'+o.id+' '+o.price+'₽');});}gid('avail-list').innerHTML=d.length?d.map(function(o){return'<div class="avail-order-card '+o.category+'"><b>#'+o.id+'</b> <span class="cat-badge '+o.category+'">'+o.category_label+'</span> — '+(o.points_count||2)+' точек<br>'+o.from_addr+' → '+o.to_addr+'<br>💰 '+o.price+'₽'+(o.driver_dist_km!==null?'<br>📡 '+o.driver_dist_km+'км':'')+(o.start_at?'<br>⏰ '+new Date(o.start_at).toLocaleString('ru'):'')+'<button class="btn-accept" style="margin-top:6px" onclick="acceptOrder('+o.id+')">✅ Принять</button></div>';}).join(''):'<div style="color:#999;text-align:center;padding:20px">Нет заказов. Откройте смену и включите GPS.</div>';}catch(e){}}
async function acceptOrder(oid){if(!confirm('Принять заказ #'+oid+'?'))return;try{var r=await fetch('/api/drivers/'+driverId+'/accept-order/'+oid,{method:'POST'});var d=await r.json();if(r.ok){alert('✅ Принят!');showPage('active');loadMy();loadAvail();}else alert(d.detail||'Ошибка');}catch(e){alert('Сеть недоступна');}}
async function loadMy(){if(!driverId)return;try{var r=await fetch('/api/drivers/'+driverId+'/orders');var d=await r.json();gid('my-orders').innerHTML=d.length?d.map(function(o){var ptsHtml='';(o.points||[]).forEach(function(p){var ic=p.point_type==='pickup'?'📦':'📋';var done=p.completed?' ✅':'';var canc=p.cancelled?' ❌':'';var act='';if(!p.completed&&!p.cancelled){act='<button class="btn-done" style="width:auto;padding:6px 10px;font-size:12px" onclick="completePt('+o.id+','+p.seq+')">✅</button>';}ptsHtml+='<div class="pt-stop '+p.point_type+(p.completed?' completed':'')+'"><b>'+ic+' Точка '+p.seq+'</b>'+done+canc+'<br>'+p.address+'<br>Контакт: '+(p.contact_name||'—')+' '+(p.contact_phone||'')+'<br>'+act+'</div>';});var stBtns='';if(o.status!=='delivered'&&o.status!=='cancelled'){stBtns='<button class="btn-status" style="width:auto;padding:6px 10px;font-size:12px" onclick="setSt('+o.id+',\\'picked\\')">Забрал</button> <button class="btn-done" style="width:auto;padding:6px 10px;font-size:12px" onclick="setSt('+o.id+',\\'delivered\\')">Доставлен</button>';}return '<div class="o-item"><b>#'+o.id+'</b> '+(o.category_label||'')+' '+(o.points_count||2)+' точек<br>'+o.from_addr+' → '+o.to_addr+'<br>Клиент: '+o.client_name+' '+o.client_phone+'<br>Цена: '+o.price+'₽ <span class="badge '+o.status+'">'+o.status+'</span>'+(o.comment?'<br><i>'+o.comment+'</i>':'')+ptsHtml+stBtns+'</div>';}).join(''):'<div style="color:#999">Заказов нет</div>';}catch(e){}}
async function completePt(oid,seq){try{var r=await fetch('/api/orders/'+oid+'/points/'+seq+'/complete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({})});if(!r.ok){var d=await r.json();alert(d.detail||'Ошибка');}loadMy();}catch(e){alert('Сеть недоступна');}}
async function setSt(oid,st){var fd=new FormData();fd.append('status',st);await fetch('/api/orders/'+oid+'/status',{method:'POST',body:fd});loadMy();loadSal();}
async function loadSal(){if(!driverId)return;try{var r=await fetch('/api/drivers/'+driverId+'/salary');var d=await r.json();gid('sal-list').innerHTML='<div style="display:flex;gap:8px;margin-bottom:12px"><div style="flex:1;background:#f0f4f8;border-radius:8px;padding:8px;text-align:center"><b style="font-size:18px;color:#357abd">'+Math.round(d.total_earned)+'₽</b><br><small>Заработано</small></div><div style="flex:1;background:#f0f4f8;border-radius:8px;padding:8px;text-align:center"><b style="font-size:18px;color:#28a745">'+Math.round(d.total_paid)+'₽</b><br><small>Выплачено</small></div><div style="flex:1;background:#f0f4f8;border-radius:8px;padding:8px;text-align:center"><b style="font-size:18px;color:#ffc107">'+Math.round(d.total_pending)+'₽</b><br><small>К выплате</small></div></div>'+(d.payments||[]).map(function(p){return'<div style="background:#f5f5f5;border-radius:8px;padding:8px;margin-bottom:6px;font-size:12px"><b>Заказ #'+p.order_id+'</b> — '+p.amount+'₽ <span class="sal-badge '+p.status+'">'+(p.status==='paid'?'✅':'⏳')+'</span><br><small>'+p.pay_detail+'</small></div>';}).join('')||'<div style="color:#999">Выплат нет</div>';}catch(e){}}
gid('cam-input').addEventListener('change',async function(){var f=gid('cam-input').files[0];if(!f)return;var rd=new FileReader();rd.onloadend=async function(){await fetch('/api/orders/'+curPhotoOid+'/points/'+curPhotoSeq+'/photo',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({photo:rd.result.split(',')[1]})});loadMy();};rd.readAsDataURL(f);});
