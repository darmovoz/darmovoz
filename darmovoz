@app.post("/api/orders/{oid}/status")
async def set_status(oid:int,request:Request,db:Session=Depends(get_db)):
    form=await request.form()
    st=form.get("status")
    o=db.query(Order).filter(Order.id==oid).first()
    if not o:raise HTTPException(404,"Заказ не найден")
    o.status=st
    if st=="delivered":
        if o.driver_id:
            drv=db.query(Driver).filter(Driver.id==o.driver_id).first()
            if drv:
                amt=round(o.price*drv.pay_rate/100) if drv.pay_type=="percent" else round(o.price*drv.pay_rate/100*0.3)
                if drv.pay_type=="per_point":
                    amt=drv.pay_rate*o.points_count
                db.add(SalaryPayment(driver_id=o.driver_id,order_id=o.id,amount=amt,
                        status="pending",pay_type=drv.pay_type,
                        pay_detail=f"{drv.pay_rate}{'%' if drv.pay_type=='percent' else '₽'}"))
    if st=="cancelled":
        add_history(db,oid,"cancelled",form.get("reason",""),"manager")
    else:
        add_history(db,oid,st,"","manager")
    db.commit()
    return{"ok":True,"status":st}

