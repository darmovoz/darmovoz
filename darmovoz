<label>Телефон</label><input id="reg-phone" placeholder="+7 999 123-45-67">
<label>Email</label><input id="reg-email" type="email" placeholder="ivan@mail.ru">
<div class="legal-toggle"><div class="lt active" onclick="setRegLegal(false,event)">👤 Физлицо</div><div class="lt" onclick="setRegLegal(true,event)">🏢 Юрлицо</div></div>
<div class="legal-fields" id="reg-legal-fields">
<label>Название компании</label><input id="reg-company" placeholder="ООО Ромашка">
<div class="row"><div><label>ИНН</label><input id="reg-inn"></div><div><label>КПП</label><input id="reg-kpp"></div></div>
<label>ОГРН</label><input id="reg-ogrn"><label>Юр. адрес</label><input id="reg-legal-addr"></div>
<button style="padding:10px;font-size:14px;margin-top:8px" onclick="doRegister()">Зарегистрироваться</button>
<div id="reg-err" style="margin-top:6px;font-size:13px"></div></div></div>
<div id="profile-banner" style="display:none"></div>
<div class="nav">
<div class="nav-btn active" onclick="showPage('order',event)">📝<br>Заказать</div>
<div class="nav-btn" onclick="showPage('myorders',event)">📂<br>Мои заказы</div>
<div class="nav-btn" onclick="showPage('track',event)">📍<br>Отследить</div>
<div class="nav-btn" onclick="showPage('pay',event)">💳<br>Оплата</div>
</div>
<div class="page active" id="page-order"><div class="card"><h2>Оформить перевозку</h2><form id="order-form">
<label>Ваше имя</label><input name="client_name" id="f-name" required>
<label>Телефон</label><input name="client_phone" id="f-phone" required>
<label>Email</label><input name="client_email" id="f-email" type="email">
<div class="legal-toggle"><div class="lt active" onclick="setOrderLegal(false,event)">👤 Физлицо</div><div class="lt" onclick="setOrderLegal(true,event)">🏢 Юрлицо</div></div>
<div class="legal-fields" id="order-legal-fields">
<label>Компания</label><input id="f-company"><div class="row"><div><label>ИНН</label><input id="f-inn"></div><div><label>КПП</label><input id="f-kpp"></div></div>
<label>ОГРН</label><input id="f-ogrn"><label>Юр. адрес</label><input id="f-legal-addr"></div>
<label>Тип исполнителя</label><select name="courier_type"><option value="car">🚗 Машина</option><option value="foot">🚶 Пеший</option></select>
<div class="pricing-tabs"><div class="ptab active" onclick="switchPricing('distance',event)">📏 По расстоянию</div><div class="ptab" onclick="switchPricing('time',event)">⏱ По времени</div></div>
<div id="pricing-time" style="display:none"><label>Часов</label><input type="number" id="ordered-hours" value="2" min="0.5" step="0.5" style="width:100px"></div>
<label>Когда начать</label><input type="datetime-local" name="start_at" id="start-at-input" required>
