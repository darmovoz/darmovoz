def haversine(lat1,lon1,lat2,lon2):
    if None in (lat1,lon1,lat2,lon2):return 0
    R=6371
    p1=math.radians(lat1);p2=math.radians(lat2)
    dphi=math.radians(lat2-lat1);dl=math.radians(lon2-lon1)
    a=math.sin(dphi/2)**2+math.cos(p1)*math.cos(p2)*math.sin(dl/2)**2
    return R*2*math.atan2(math.sqrt(a),math.sqrt(1-a))

def calc_category(start_at):
    if not start_at:return "current"
    now=datetime.utcnow()
    diff=(start_at-now).total_seconds()
    if diff<1800:return "burning"
    if diff<7200:return "urgent"
    if diff<86400:return "current"
    return "preliminary"

def calc_price(db,courier_type,distance_km,cargo_type,loaders,floors_up,floors_down,has_elevator,pricing_type,ordered_hours,created_at=None):
    t=db.query(Tariff).first()
    if not t:
        t=Tariff();db.add(t);db.commit()
    is_foot=courier_type=="foot"
    base=t.foot_base_price if is_foot else t.base_price
    per_km=t.foot_per_km if is_foot else t.per_km
    min_p=t.foot_min_price if is_foot else t.min_price
    hourly=t.foot_hourly_rate if is_foot else t.hourly_rate
    if pricing_type=="time":
        price=hourly*ordered_hours
    else:
        price=base+per_km*distance_km
    if cargo_type=="fragile":price*=t.fragile_mult
    if loaders:price+=t.loader_cost*loaders
    if not has_elevator:
        price+=t.floor_cost*(floors_up+floors_down)
    if created_at:
        h=created_at.hour
        if h>=22 or h<6:price*=t.night_mult
        elif h in (8,9,18,19):price*=t.rush_mult
    return max(min_p,round(price))

def add_history(db,oid,action,detail,actor):
