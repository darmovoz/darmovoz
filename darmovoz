</style></head><body><div class="wrap">
<h1>🚚 Дармовоз-СПб</h1>
<div class="card" id="auth-section"><div class="auth-tabs">
<div class="auth-tab active" onclick="switchAuth('login',event)">🔐 Вход</div>
<div class="auth-tab" onclick="switchAuth('register',event)">📝 Регистрация</div></div>
<div class="auth-form show" id="auth-login">
