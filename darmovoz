@app.post("/api/orders/{oid}/auto-assign")
async def auto_assign(oid:int,db:Session=Depends(get_db)):
    o=db.query(Order).filter(Order.id==oid).first()
    if not o:raise HTTPException(404,"Заказ не найден")
    drv=db.query(Driver).filter(Driver.status=="free",Driver.contract_accepted==True,
              Driver.courier_type==o.courier_type).all()
    if not drv:raise HTTPException(400,"Нет свободных исполнителей")
    d=drv[0]
    if o.from_lat and d.lat:
        drv.sort(key=lambda x:haversine(o.from_lat,o.from_lon,x.lat,x.lon))
        d=drv[0]
    o.driver_id=d.id;o.status="assigned";d.status="busy"
    db.commit()
    add_history(db,oid,"auto-assigned",d.name,"system")
    return{"ok":True,"driver":d.name}

