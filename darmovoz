@app.post("/api/orders/{oid}/points/{seq}/photo")
async def upload_photo(oid:int,seq:int,request:Request,db:Session=Depends(get_db)):
    d=await request.json()
    b64=d.get("photo","")
    p=db.query(OrderPoint).filter(OrderPoint.order_id==oid,OrderPoint.seq==seq).first()
    if not p:raise HTTPException(404,"Точка не найдена")
    fname=f"photo_{oid}_{seq}_{int(time.time())}.jpg"
    os.makedirs("uploads",exist_ok=True)
    with open(f"uploads/{fname}","wb") as f:
        f.write(base64.b64decode(b64))
    photos=json.loads(p.photos) if p.photos else []
    photos.append(fname)
    p.photos=json.dumps(photos)
    db.commit()
    return{"ok":True,"filename":fname}

