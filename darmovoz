<script>
var map=null,managerRole=null,driversCache=[],ordersCache=[];
var TARIFF_KEYS=['base_price','per_km','fragile_mult','loader_cost','floor_cost','min_price','night_mult','rush_mult','hourly_rate','foot_base_price','foot_per_km','foot_min_price','foot_hourly_rate'];
var ROLE_TABS={director:['orders','neworder','drivers','finance','salary','invoices','tariffs','analytics','crm'],logist:['orders','neworder','drivers','analytics'],buh:['finance','salary','invoices','analytics','crm']};
async function managerLogin(){var u=document.getElementById('m-username').value.trim(),p=document.getElementById('m-password').value.trim();try{var r=await fetch('/api/manager/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:u,password:p})});var d=await r.json();if(r.ok){managerRole=d.role;document.getElementById('login-screen').style.display='none';document.getElementById('main-layout').style.display='grid';applyRole();initMap();loadData();}else{document.getElementById('m-err').innerHTML='<span style="color:#dc3545">'+(d.detail||'Ошибка')+'</span>';}}catch(e){document.getElementById('m-err').innerHTML='<span style="color:#dc3545">Сеть недоступна</span>';}}
function applyRole(){var allowed=ROLE_TABS[managerRole]||[];document.querySelectorAll('.tab').forEach(function(t){t.style.display=allowed.indexOf(t.dataset.tab)===-1?'none':'';});var first=document.querySelector('.tab:not([style*="none"])');if(first)showTab(first.dataset.tab,{target:first});}
function showTab(n,e){document.querySelectorAll('.tab').forEach(function(t){t.classList.remove('active')});document.querySelectorAll('.tc').forEach(function(t){t.classList.remove('active')});e.target.closest('.tab').classList.add('active');document.getElementById('tc-'+n).classList.add('active');if(n==='tariffs')loadTariffs();if(n==='analytics')loadAnalytics();if(n==='crm')loadClients();if(n==='invoices')loadInvoices();if(n==='salary')loadSalary();if(n==='finance')loadFinance();if(n==='neworder')initNewOrder();}
function initMap(){if(map)return;map=L.map('map').setView([59.9343,30.3351],11);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19}).addTo(map);}
async function loadData(){try{var os=await fetch('/api/orders').then(function(r){return r.json();});var ds=await fetch('/api/drivers').then(function(r){return r.json();});driversCache=ds;ordersCache=os;document.getElementById('st-o').textContent=os.length;document.getElementById('st-a').textContent=os.filter(function(o){return['delivered','cancelled'].indexOf(o.status)===-1;}).length;document.getElementById('st-r').textContent=Math.round(os.filter(function(o){return o.status==='delivered';}).reduce(function(s,o){return s+o.price;},0))+'₽';
var catLabels={burning:'🔥',urgent:'⚡',current:'📍',preliminary:'📋'};
document.getElementById('orders-tb').innerHTML=os.map(function(o){var ct=o.courier_type==='foot'?'🚶':'🚗';var catB='<span class="cat-badge '+o.category+'">'+(catLabels[o.category]||'📋')+'</span>';var pay=o.payment_status==='paid'?'<span class="pay-badge paid">✅</span>':o.payment_status==='invoice_requested'?'<span class="pay-badge invoice_requested">🧾</span>':'<span class="pay-badge unpaid">❌</span>';var act='';if(o.status==='created'){var opts=ds.filter(function(d){return d.contract_accepted;}).map(function(d){return'<option value="'+d.id+'"'+(d.id===o.driver_id?' selected':'')+'>'+d.name+'</option>';}).join('');act='<select id="as-'+o.id+'" style="width:80px;font-size:11px;padding:3px">'+opts+'</select><button class="sm green" onclick="assignDriver('+o.id+')">Назн.</button><button class="sm orange" onclick="autoAssign('+o.id+')">🤖</button><button class="sm red" onclick="cancelOrder('+o.id+')">Отм.</button>';}else if(o.status!=='cancelled'&&o.status!=='delivered'){act='<button class="sm" onclick="setStatus('+o.id+',\\'delivered\\')">Достав.</button> <button class="sm red" onclick="cancelOrder('+o.id+')">Отм.</button>';}return'<tr><td>'+o.id+'</td><td>'+o.client_name+'<br><small>'+o.client_phone+'</small>'+(o.comment?'<br><small>📝'+o.comment+'</small>':'')+'</td><td>'+catB+'</td><td>'+ct+'</td><td>'+(o.points_count||2)+'</td><td>'+o.price+'</td><td><span class="badge '+o.status+'">'+o.status+'</span></td><td>'+pay+'</td><td>'+act+'</td></tr>';}).join('');
document.getElementById('drivers-tb').innerHTML=ds.map(function(d){return'<tr><td>'+d.id+'</td><td>'+d.name+'</td><td>'+(d.courier_type==='foot'?'🚶':'🚗')+'</td><td><span class="badge '+(d.status==='free'?'picked':d.status==='busy'?'cancelled':'delivered')+'">'+d.status+'</span></td><td>'+(d.contract_accepted?'✅':'❌')+'</td><td>'+d.pay_type+' '+d.pay_rate+'</td></tr>';}).join('');
if(map){map.eachLayer(function(l){if(l instanceof L.Marker)map.removeLayer(l);});os.forEach(function(o){if(o.status==='cancelled'||o.status==='delivered')return;if(!o.from_lat)return;var ic=o.category==='burning'?'🔥':o.category==='urgent'?'⚡':'📍';L.marker([o.from_lat,o.from_lon],{icon:L.divIcon({html:ic,iconSize:[28,28],className:''})}).addTo(map).bindPopup('#'+o.id+' '+o.from_addr+' '+o.price+'₽');});ds.forEach(function(d){if(d.lat&&d.lon)L.marker([d.lat,d.lon],{icon:L.divIcon({html:d.courier_type==='foot'?'🚶':'🚗',iconSize:[24,24],className:''})}).addTo(map).bindPopup(d.name);});}}catch(e){console.error(e);}}
