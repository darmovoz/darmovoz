@app.get("/api/geocode/search")
async def geo_search(q:str):
    import urllib.request
    url=f"https://nominatim.openstreetmap.org/search?format=json&limit=5&q={urllib.parse.quote(q)}"
    try:
        with urllib.request.urlopen(url,timeout=5) as r:
            data=json.loads(r.read())
        return[{"lat":float(d["lat"]),"lon":float(d["lon"]),"display_name":d["display_name"]} for d in data]
    except:return[]

@app.get("/api/geocode/reverse")
async def geo_reverse(lat:float,lon:float):
    import urllib.request
    url=f"https://nominatim.openstreetmap.org/reverse?format=json&lat={lat}&lon={lon}"
    try:
        with urllib.request.urlopen(url,timeout=5) as r:
            data=json.loads(r.read())
        return{"address":data.get("display_name","")}
    except:return{"address":""}

