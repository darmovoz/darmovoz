@app.get("/api/finance")
async def finance(db:Session=Depends(get_db)):
    os_=db.query(Order).all()
    delivered=[o for o in os_ if o.status=="delivered"]
    drv_cost=sum(db.query(SalaryPayment).filter(SalaryPayment.order_id==o.id).first().amount
                 for o in delivered if db.query(SalaryPayment).filter(SalaryPayment.order_id==o.id).first())
    rev=sum(o.price for o in delivered)
    client_paid=sum(o.price for o in os_ if o.payment_status=="paid")
    client_pending=sum(o.price for o in os_ if o.payment_status!="paid" and o.status!="cancelled")
    drv_pays=db.query(SalaryPayment).all()
    drv_paid=sum(p.amount for p in drv_pays if p.status=="paid")
    drv_pending=sum(p.amount for p in drv_pays if p.status=="pending")
    drvs=db.query(Driver).all()
    drv_list=[]
    for d in drvs:
        ps=db.query(SalaryPayment).filter(SalaryPayment.driver_id==d.id).all()
        ords=db.query(Order).filter(Order.driver_id==d.id).all()
        drv_list.append({"name":d.name,"orders":len(ords),
                          "earned":sum(p.amount for p in ps),
                          "paid":sum(p.amount for p in ps if p.status=="paid"),
                          "pending":sum(p.amount for p in ps if p.status=="pending")})
    cls=db.query(Client).all()
    cl_list=[]
    for c in cls:
        ords=db.query(Order).filter(Order.client_phone==c.phone).all()
        cl_list.append({"name":c.name,"orders":len(ords),
                         "spent":sum(o.price for o in ords),
                         "paid":sum(o.price for o in ords if o.payment_status=="paid"),
                         "unpaid":sum(o.price for o in ords if o.payment_status!="paid" and o.status!="cancelled")})
    return{"net_profit":rev-drv_cost,"delivered_revenue":rev,
            "delivered_driver_cost":drv_cost,"client_revenue_total":client_paid,
            "client_revenue_pending":client_pending,"driver_payments_paid":drv_paid,
            "driver_payments_pending":drv_pending,"delivered_count":len(delivered),
            "drivers":drv_list,"clients":cl_list}

@app.get("/api/analytics")
async def analytics(db:Session=Depends(get_db)):
    os_=db.query(Order).all()
    cat_counts={"burning":0,"urgent":0,"current":0,"preliminary":0}
    st_counts={}
    for o in os_:
        if o.category in cat_counts:cat_counts[o.category]+=1
        st_counts[o.status]=st_counts.get(o.status,0)+1
    delivered=[o for o in os_ if o.status=="delivered"]
    rev=sum(o.price for o in delivered)
    avg=rev/len(delivered) if delivered else 0
    now=datetime.utcnow()
    weekly=[]
    for i in range(6,-1,-1):
        day=now-timedelta(days=i)
        cnt=db.query(Order).filter(Order.created_at>=day.replace(hour=0,minute=0,second=0),
                 Order.created_at<day.replace(hour=0,minute=0,second=0)+timedelta(days=1)).count()
        weekly.append({"date":day.strftime("%d.%m"),"orders":cnt})
    drvs=db.query(Driver).all()
    top=[]
    for d in drvs:
        ords=db.query(Order).filter(Order.driver_id==d.id).all()
        top.append({"name":d.name,"orders":len(ords),
                     "delivered":len([o for o in ords if o.status=="delivered"]),
                     "revenue":sum(o.price for o in ords if o.status=="delivered")})
    top.sort(key=lambda x:x["revenue"],reverse=True)
    drv_cost=sum(db.query(SalaryPayment).filter(SalaryPayment.order_id==o.id).first().amount
                 for o in delivered if db.query(SalaryPayment).filter(SalaryPayment.order_id==o.id).first())
    return{"total_orders":len(os_),"delivered_count":len(delivered),
            "total_revenue":rev,"avg_price":round(avg),"net_profit":rev-drv_cost,
            "client_revenue_paid":sum(o.price for o in os_ if o.payment_status=="paid"),
            "category_counts":cat_counts,"status_counts":st_counts,
            "weekly":weekly,"top_drivers":top[:5],
            "car_count":len([o for o in os_ if o.courier_type=="car"]),
            "foot_count":len([o for o in os_ if o.courier_type=="foot"])}

