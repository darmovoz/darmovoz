@app.post("/api/orders/{oid}/points/{seq}/complete")
async def complete_pt(oid:int,seq:int,request:Request,db:Session=Depends(get_db)):
    p=db.query(OrderPoint).filter(OrderPoint.order_id==oid,OrderPoint.seq==seq).first()
    if not p:raise HTTPException(404,"Точка не найдена")
    d=await request.json() if request.headers.get("content-type","").startswith("application/json") else {}
    drv_lat=d.get("lat");drv_lon=d.get("lon")
    dist=None
    if p.lat and drv_lat:
        dist=round(haversine(p.lat,p.lon,float(drv_lat),float(drv_lon))*1000)
        if dist>500:raise HTTPException(400,f"Слишком далеко: {dist}м")
    p.completed=True;p.completed_dist_m=dist;p.completed_at=datetime.utcnow()
    db.commit()
    add_history(db,oid,"point_done",f"Точка {seq}","driver")
    return{"ok":True,"dist_m":dist}

