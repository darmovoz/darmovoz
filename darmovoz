@app.post("/api/orders")
async def create_order(request:Request,db:Session=Depends(get_db)):
    form=await request.form()
    pts_raw=form.get("points_json","[]")
    pts=json.loads(pts_raw)
    if len(pts)<2:raise HTTPException(400,"Нужно минимум 2 точки")
    courier_type=form.get("courier_type","car")
    pricing_type=form.get("pricing_type","distance")
    ordered_hours=float(form.get("ordered_hours",0))
    cargo_type=form.get("cargo_type","standard")
    loaders=int(form.get("loaders",0))
    floors_up=int(form.get("floors_up",0))
    floors_down=int(form.get("floors_down",0))
    has_elevator=form.get("has_elevator","false")=="true"
    start_str=form.get("start_at")
    start_at=datetime.fromisoformat(start_str) if start_str else None
    cat=calc_category(start_at)
    lats=[];lons=[]
    for p in pts:
        if p.get("lat") and p.get("lon"):
            lats.append(float(p["lat"]));lons.append(float(p["lon"]))
    dist=0
    for i in range(len(lats)-1):
        dist+=haversine(lats[i],lons[i],lats[i+1],lons[i+1])
    now=datetime.utcnow()
    price=calc_price(db,courier_type,dist,cargo_type,loaders,floors_up,floors_down,has_elevator,pricing_type,ordered_hours,now)
    o=Order(client_name=form.get("client_name",""),client_phone=form.get("client_phone",""),
            client_email=form.get("client_email",""),courier_type=courier_type,
            pricing_type=pricing_type,ordered_hours=ordered_hours,distance_km=round(dist,1),
            price=price,status="created",category=cat,start_at=start_at,
            comment=form.get("comment",""),cargo_type=cargo_type,loaders=loaders,
            floors_up=floors_up,floors_down=floors_down,has_elevator=has_elevator,
            is_legal=form.get("is_legal","false")=="true",
            client_company=form.get("client_company"),client_inn=form.get("client_inn"),
            client_kpp=form.get("client_kpp"),client_ogrn=form.get("client_ogrn"),
            client_legal_addr=form.get("client_legal_addr"),
            created_by=form.get("created_by","client"),
            from_addr=pts[0].get("address",""),to_addr=pts[-1].get("address",""),
            from_lat=lats[0] if lats else None,from_lon=lons[0] if lons else None,
            to_lat=lats[-1] if lats else None,to_lon=lons[-1] if lons else None,
            points_count=len(pts))
    db.add(o);db.commit()
    for i,p in enumerate(pts):
        db.add(OrderPoint(order_id=o.id,seq=i+1,address=p.get("address",""),
                          point_type=p.get("point_type","pickup"),
                          contact_name=p.get("contact_name"),contact_phone=p.get("contact_phone"),
                          lat=float(p["lat"]) if p.get("lat") else None,
                          lon=float(p["lon"]) if p.get("lon") else None))
    db.commit()
    add_history(db,o.id,"created",f"Цена: {price}₽",form.get("created_by","client"))
    cl=db.query(Client).filter(Client.phone==o.client_phone).first()
    if cl:
        cl.total_orders+=1;cl.total_spent+=price;db.commit()
    return{"id":o.id,"price":price,"distance_km":round(dist,1),"points_count":len(pts),
           "category":cat,"message":"Заказ создан","ordered_hours":ordered_hours}

